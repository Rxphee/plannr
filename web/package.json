{
    "name": "plannr-web",
    "private": true,
    "license": "AGPL-3.0-only",
    "scripts": {
        "build": "npm run gql:types && next build",
        "check-node-version": "check-node-version --node $(cat ../.nvmrc)",
        "dev": "npm run check-node-version && npm run gql:types && dotenv -e .env.secrets -e .env.local -e .env -- sh -c 'next dev --port $WEB_PORT'",
        "gql:types": "graphql-codegen",
        "gql:watch": "graphql-codegen --watch",
        "prelint": "npm run gql:types",
        "lint": "run-p -l lint:{eslint,knip,prettier,tsc}",
        "lint:ci": "npm run lint",
        "lint:eslint": "eslint --max-warnings 0 src/ '**/*.json' --no-warn-ignored",
        "lint:fix": "run-p lint:fix:{eslint,prettier}",
        "lint:fix:eslint": "npm run lint:eslint -- --fix",
        "lint:fix:prettier": "npm run lint:prettier -- --write",
        "lint:knip": "knip --exports --files --dependencies --tags=-knipignore",
        "lint:prettier": "npx prettier --check '*.{ts,js,mjs,json,md,yml,yaml,css}' 'src/**/*.css'",
        "lint:tsc": "npx next typegen && tsc --project .",
        "start": "dotenv -e .env.secrets -e .env.local -e .env -- sh -c 'next start --port $WEB_PORT'",
        "test": "vitest --run",
        "test:ci": "npm run test",
        "test:watch": "vitest --watch"
    },
    "dependencies": {
        "@base-ui/react": "^1.9.0",
        "@tiptap/core": "^3.32.0",
        "@tiptap/extension-list": "^3.32.0",
        "@tiptap/extensions": "^3.32.0",
        "@tiptap/markdown": "^3.32.0",
        "@tiptap/pm": "^3.32.0",
        "@tiptap/react": "^3.32.0",
        "@tiptap/starter-kit": "^3.32.0",
        "class-variance-authority": "^0.7.1",
        "cn": "^0.5.0",
        "date-fns": "^4.4.0",
        "final-form": "^5.0.1",
        "graphql": "^16.14.2",
        "jose": "^6.2.13",
        "lucide-react": "^1.61.0",
        "next": "^16.4.3",
        "openid-client": "^6.8.8",
        "react": "^19.3.1",
        "react-day-picker": "^10.0.2",
        "react-dom": "^19.3.1",
        "react-final-form": "^7.0.1",
        "server-only": "^0.0.1",
        "shadcn": "^4.22.1"
    },
    "devDependencies": {
        "@dextinity/eslint-config": "^10.10.0",
        "@graphql-codegen/cli": "^7.4.6",
        "@graphql-codegen/named-operations-object": "^4.0.1",
        "@graphql-codegen/near-operation-file-preset": "^5.2.3",
        "@graphql-codegen/typescript": "^6.1.2",
        "@graphql-codegen/typescript-operations": "^6.2.0",
        "@parcel/watcher": "^2.6.0",
        "@tailwindcss/postcss": "^4.3.3",
        "@types/node": "^26.0.0",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "check-node-version": "^4.2.1",
        "dotenv-cli": "^11.0.0",
        "eslint": "^9.39.5",
        "knip": "^6.43.0",
        "npm-run-all2": "^9.0.4",
        "prettier": "^3.9.10",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "typescript": "^6.0.3",
        "vitest": "^5.0.5"
    },
    "engines": {
        "node": "26"
    }
}
