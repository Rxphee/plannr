{
    "name": "plannr-api",
    "version": "1.0.0",
    "private": true,
    "license": "AGPL-3.0-only",
    "type": "module",
    "scripts": {
        "build": "nest build",
        "check-node-version": "check-node-version --node $(cat ../.nvmrc)",
        "console": "dotenv -e .env.secrets -e .env.local -e .env -- node dist/console.js",
        "console:prod": "node dist/console.js",
        "db:migrate": "npm run build && npm run console migrate --",
        "db:migrate:prod": "npm run console:prod migrate --",
        "db:migration:create": "npm run build && npm run mikro-orm migration:create --",
        "lint": "run-p -l lint:{eslint,knip,prettier,tsc,api-can-start}",
        "lint:api-can-start": "nest build && NODE_ENV=development dotenv -e ../.env -- node dist/console.js --help",
        "lint:ci": "npm run lint && npm run lint:generated-files-not-modified",
        "lint:eslint": "eslint --max-warnings 0 src/ '**/*.json' --no-warn-ignored",
        "lint:fix": "run-p lint:fix:{eslint,prettier}",
        "lint:fix:eslint": "npm run lint:eslint -- --fix",
        "lint:fix:prettier": "npm run lint:prettier -- --write",
        "lint:generated-files-not-modified": "git diff --exit-code HEAD -- schema.gql",
        "lint:knip": "knip --exports --files --dependencies --tags=-knipignore",
        "lint:prettier": "npx prettier --check '*.{ts,js,mjs,json,md,yml,yaml}'",
        "lint:tsc": "tsc --project ./tsconfig.lint.json",
        "mikro-orm": "dotenv -e .env.secrets -e .env.local -e .env -- mikro-orm --config ./dist/db/ormconfig.cli.js",
        "start": "dotenv -e .env.secrets -e .env.local -e .env -- nest start",
        "start:debug": "dotenv -e .env.secrets -e .env.local -e .env -- nest start --debug --watch --preserveWatchOutput",
        "start:dev": "npm run check-node-version && npm run db:migrate && dotenv -e .env.secrets -e .env.local -e .env -- nest start --watch --preserveWatchOutput",
        "start:prod": "node dist/main.js",
        "test": "vitest --run",
        "test:ci": "npm run test",
        "test:watch": "vitest --watch"
    },
    "dependencies": {
        "@apollo/server": "^5.5.1",
        "@as-integrations/express5": "^1.1.2",
        "@mikro-orm/core": "^7.2.5",
        "@mikro-orm/migrations": "^7.2.5",
        "@mikro-orm/nestjs": "^7.1.0",
        "@mikro-orm/postgresql": "^7.2.5",
        "@nestjs/apollo": "^14.0.3",
        "@nestjs/common": "^12.2.0",
        "@nestjs/core": "^12.2.0",
        "@nestjs/graphql": "^14.0.3",
        "@nestjs/platform-express": "^12.2.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.15.1",
        "compression": "^1.8.2",
        "graphql": "^16.14.2",
        "helmet": "^8.3.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2"
    },
    "devDependencies": {
        "@dextinity/eslint-config": "^10.10.0",
        "@mikro-orm/cli": "^7.2.5",
        "@nestjs/cli": "^12.0.10",
        "@nestjs/schematics": "^12.0.10",
        "@types/compression": "^1.8.1",
        "@types/node": "^26.0.0",
        "check-node-version": "^4.2.1",
        "dotenv-cli": "^11.0.0",
        "eslint": "^9.39.5",
        "knip": "^6.43.0",
        "npm-run-all2": "^9.0.4",
        "prettier": "^3.9.10",
        "typescript": "^6.0.3",
        "vitest": "^5.0.5"
    },
    "engines": {
        "node": "26"
    }
}
