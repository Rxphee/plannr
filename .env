# node
NODE_ENV=development

# postgres
POSTGRESQL_HOST=localhost
POSTGRESQL_PORT=5432
POSTGRESQL_USER=plannr
POSTGRESQL_PASSWORD=plannr
POSTGRESQL_DB=main

# oidc (Zitadel, in development a local one; OIDC_CLIENT_ID and OIDC_CLIENT_SECRET come from .env.zitadel)
OIDC_PROVIDER_PORT=8180
OIDC_ISSUER=http://localhost:${OIDC_PROVIDER_PORT}
# The page of dev/zitadel/login.mts, where development users are chosen from a list
OIDC_LOGIN_PORT=8181
OIDC_LOGIN_URL=http://localhost:${OIDC_LOGIN_PORT}
# The ID of the Zitadel project
OIDC_AUDIENCE=plannr
# Development value only, production sets its own
SESSION_SECRET=plannr-development-session-secret-of-32-characters

# s3 (optional, without S3_ENDPOINT there are no image uploads; a local Garage in development)
S3_PORT=3900
S3_ENDPOINT=http://localhost:${S3_PORT}
S3_REGION=garage
S3_BUCKET=plannr
# true for Garage and MinIO, which expect the bucket in the path
S3_FORCE_PATH_STYLE=true
# Development values only, production sets its own
S3_ACCESS_KEY_ID=GK1a02b845b4efa607963f9d96
S3_SECRET_ACCESS_KEY=d876c29f966e6edf9a31d33ae88b43bfc0d6169b6c9464ce23ac8788f28b2d28

# api
API_PORT=4000
# Comma-separated; the super-admin also needs an email address the identity provider marks as verified
SUPER_ADMIN_EMAILS=admin@plannr.localhost
API_URL=http://localhost:${API_PORT}/api
CORS_ALLOWED_ORIGIN=^http://localhost:${WEB_PORT}$

# web
WEB_PORT=3000
WEB_URL=http://localhost:${WEB_PORT}
